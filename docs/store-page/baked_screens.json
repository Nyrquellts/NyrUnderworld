 "bank": "<main id=\"bank\">\n  <header class=\"screen-head\">\n    <h1 class=\"screen-title\">Bank</h1>\n    <span id=\"bank-number\" class=\"screen-note\">NYR-EEEF-A6GE</span>\n  </header>\n  <p id=\"bank-balance\" class=\"bank-balance\">$390.00</p>\n  <div id=\"bank-counter\" class=\"bank-counter\">\n    <label class=\"field\">\n      <span>Amount</span>\n      <input id=\"bank-amount\" type=\"number\" min=\"1\" step=\"1\" inputmode=\"numeric\" placeholder=\"0\">\n    </label>\n    <button id=\"bank-deposit\" type=\"button\">Pay in</button>\n    <button id=\"bank-withdraw\" type=\"button\">Take out</button>\n  </div>\n  <button id=\"bank-open\" class=\"primary\" type=\"button\" hidden=\"\">Open an account</button>\n  <ul id=\"bank-lines\" class=\"around\"><li class=\"place\">\n    <span class=\"place-what\">deposit</span>\n    <span class=\"place-where\"></span>\n    <span class=\"place-deal\"><span class=\"place-price\">$450.00</span></span>\n  </li><li class=\"place out\">\n    <span class=\"place-what\">withdrawal</span>\n    <span class=\"place-where\"></span>\n    <span class=\"place-deal\"><span class=\"place-price\">-$60.00</span></span>\n  </li></ul>\n  <p id=\"bank-empty\" class=\"empty\" hidden=\"\">Nothing has moved through this account yet.</p>\n  <p id=\"bank-message\" class=\"message\" hidden=\"\" role=\"status\" aria-live=\"polite\"></p>\n  <footer>\n    <button class=\"close-screen quiet\" type=\"button\">Close</button>\n    <span class=\"hint\">Esc</span>\n  </footer>\n</main>",

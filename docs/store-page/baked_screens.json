 "nearby": "<main id=\"nearby\">\n  <header class=\"screen-head\">\n    <h1 class=\"screen-title\">Around you</h1>\n  </header>\n  <ul id=\"around\" class=\"around\"><li class=\"place\">\n    <span class=\"place-what\">Rob's Liquor</span>\n    <span class=\"place-where\">shop</span>\n    <span class=\"place-deal\">\n      <span class=\"place-price\" hidden=\"\"></span>\n      <button type=\"button\" class=\"place-buy\" hidden=\"\">Buy</button>\n      <button type=\"button\" class=\"place-go primary\">Counter</button>\n    </span>\n  </li><li class=\"place\">\n    <span class=\"place-what\">Integrity Way, Apt 28</span>\n    <span class=\"place-where\">yours</span>\n    <span class=\"place-deal\">\n      <span class=\"place-price\" hidden=\"\"></span>\n      <button type=\"button\" class=\"place-buy\" hidden=\"\">Buy</button>\n      <button type=\"button\" class=\"place-go primary\">Go in</button>\n    </span>\n  </li><li class=\"place\">\n    <span class=\"place-what\">Alta Street, Apt 57</span>\n    <span class=\"place-where\">apartment \u00b7 for sale</span>\n    <span class=\"place-deal\">\n      <span class=\"place-price\">$3,200.00</span>\n      <button type=\"button\" class=\"place-buy\">Buy</button>\n      <button type=\"button\" class=\"place-go primary\">Go in</button>\n    </span>\n  </li><li class=\"place\">\n    <span class=\"place-what\">Rob's Liquor, Grove Street</span>\n    <span class=\"place-where\">shop</span>\n    <span class=\"place-deal\">\n      <span class=\"place-price\" hidden=\"\"></span>\n      <button type=\"button\" class=\"place-buy\" hidden=\"\">Buy</button>\n      <button type=\"button\" class=\"place-go primary\" hidden=\"\">Go in</button>\n    </span>\n  </li><li class=\"place\">\n    <span class=\"place-what\">Cypress Flats Scrapyard</span>\n    <span class=\"place-where\">shop</span>\n    <span class=\"place-deal\">\n      <span class=\"place-price\" hidden=\"\"></span>\n      <button type=\"button\" class=\"place-buy\" hidden=\"\"